<?xml version="1.0" encoding="utf-8"?>
<!--
    The Syncthing core's REST API is plain HTTP on the loopback interface. Android blocks cleartext
    traffic by default (API 28+, still enforced on e.g. Android 13), so allow it for loopback only;
    everything else stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
