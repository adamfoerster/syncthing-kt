<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only needs the grid background (light here, dark in values-night) to avoid a flash. -->
    <style name="Theme.Syncthing" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ng_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="ng_bg">#FFF4F7FA</color>
    <color name="ng_cyan">#FF00707C</color>
    <!-- The launcher icon stays on the dark grid in both themes. -->
    <color name="ng_icon_bg">#FF080A0F</color>
</resources>
